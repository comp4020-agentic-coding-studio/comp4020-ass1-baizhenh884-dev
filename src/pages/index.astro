---
import Layout from "../layouts/Layout.astro";
import { calculateNetworkState } from "../scripts/braess-model";

// Tier B slice: all displayed numbers come from the real model, computed at
// build time — never hard-coded — and formatted with an explicit locale so
// the output doesn't depend on the machine building the site.
const driverCount = new Intl.NumberFormat("en-AU");
const TOTAL_DRIVERS = 4000;
const initial = calculateNetworkState({
  shortcutBuilt: false,
  totalDrivers: TOTAL_DRIVERS,
});
const routeDrivers = driverCount.format(initial.allocation.viaNode1Only);
const equilibriumMinutes = initial.equilibriumTravelTimeMinutes;
const initialEdgeMinutes = initial.allocation.viaNode1Only / 100;
const initialEquation = `${initialEdgeMinutes} + 45 = ${equilibriumMinutes} min`;

// Decorative skyline behind the opening scene: buildings and their windows
// are generated once at build time from a deterministic pseudo-random
// sequence, not client JS, so the output is static and reproducible.
function skylineRandom(seed: number): number {
  const value = Math.sin(seed * 12.9898) * 43758.5453;
  return value - Math.floor(value);
}

// Wide enough that the viewBox's own aspect ratio comfortably exceeds the
// widest real container's (the .page column, ~1112px over an 84px-tall
// band) — otherwise preserveAspectRatio="slice" zooms in vertically instead
// of cropping the sides, and the buildings read as a few giant blocks.
const SKYLINE_BUILDING_COUNT = 50;
const SKYLINE_GAP = 6;
const SKYLINE_HEIGHT = 150;
const SKYLINE_MARGIN = 6;
const SKYLINE_WINDOW_WIDTH = 4;
const SKYLINE_WINDOW_HEIGHT = 6;
const SKYLINE_WINDOW_GAP_X = 9;
const SKYLINE_WINDOW_GAP_Y = 11;

interface SkylineWindow {
  x: number;
  y: number;
  lit: boolean;
}

interface SkylineBuilding {
  x: number;
  width: number;
  height: number;
  windows: SkylineWindow[];
}

let skylineCursor = 0;
const skylineBuildings: SkylineBuilding[] = Array.from(
  { length: SKYLINE_BUILDING_COUNT },
  (_, i) => {
    const width = 28 + Math.round(skylineRandom(i * 2 + 1) * 24);
    const height = 46 + Math.round(skylineRandom(i * 2 + 2) * 96);
    const x = skylineCursor;
    skylineCursor += width + SKYLINE_GAP;

    const usableWidth = width - SKYLINE_MARGIN * 2;
    const usableHeight = height - SKYLINE_MARGIN * 2;
    const cols = Math.max(
      1,
      Math.floor(
        (usableWidth + SKYLINE_WINDOW_GAP_X) /
          (SKYLINE_WINDOW_WIDTH + SKYLINE_WINDOW_GAP_X),
      ),
    );
    const rows = Math.max(
      1,
      Math.floor(
        (usableHeight + SKYLINE_WINDOW_GAP_Y) /
          (SKYLINE_WINDOW_HEIGHT + SKYLINE_WINDOW_GAP_Y),
      ),
    );

    const windows: SkylineWindow[] = [];
    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        windows.push({
          x: SKYLINE_MARGIN + col * (SKYLINE_WINDOW_WIDTH + SKYLINE_WINDOW_GAP_X),
          y: SKYLINE_MARGIN + row * (SKYLINE_WINDOW_HEIGHT + SKYLINE_WINDOW_GAP_Y),
          lit: skylineRandom(i * 97 + row * 13 + col * 7 + 3) > 0.8,
        });
      }
    }

    return { x, width, height, windows };
  },
);
const SKYLINE_WIDTH = skylineCursor - SKYLINE_GAP;

// Two residents' speech bubbles, floating above short buildings near the
// horizontal centre of the skyline so they stay inside the visible crop at
// every viewport width. Hidden on narrow screens instead (see global.css) —
// the shortened mobile skyline doesn't have the vertical headroom to spare.
const SKYLINE_BUBBLE_WIDTH = 190;
const SKYLINE_BUBBLE_HEIGHT = 46;
const SKYLINE_BUBBLE_RADIUS = 8;
// Half-width of the horizontal band checked for nearby rooftops when placing
// a bubble: enough to cover the buildings actually behind it, not so wide
// that a distant unrelated tower (this skyline has some much taller than
// its neighbours) makes every position infeasible.
const SKYLINE_BUBBLE_CLEARANCE_RADIUS = 60;
// Gap between the bubble's bottom edge and the tallest nearby rooftop, so it
// visibly floats clear of the skyline instead of resting on it.
const SKYLINE_BUBBLE_HEADROOM = 20;

function tallestNearbyHeight(centerX: number): number {
  const left = centerX - SKYLINE_BUBBLE_CLEARANCE_RADIUS;
  const right = centerX + SKYLINE_BUBBLE_CLEARANCE_RADIUS;
  let max = 0;
  for (const b of skylineBuildings) {
    if (b.x + b.width >= left && b.x <= right) {
      max = Math.max(max, b.height);
    }
  }
  return max;
}

// Picks the building in [start, end] with the most open sky above it and its
// immediate neighbours, so a bubble anchored there has room to float clear
// of the nearby skyline, not just its own rooftop.
function quietestBuildingInRange(start: number, end: number) {
  let bestIndex = start;
  let bestClearance = -Infinity;
  for (let i = start; i <= end; i++) {
    const building = skylineBuildings[i];
    const centerX = building.x + building.width / 2;
    const clearance = SKYLINE_HEIGHT - tallestNearbyHeight(centerX);
    if (clearance > bestClearance) {
      bestClearance = clearance;
      bestIndex = i;
    }
  }
  return bestIndex;
}

interface SkylineBubble {
  centerX: number;
  top: number;
  bottom: number;
  tailApexY: number;
  lines: readonly [string, string];
}

const skylineBubbles: SkylineBubble[] = (
  [
    [
      quietestBuildingInRange(14, 23),
      ["Maybe the new road", "will fix my commute."],
    ],
    [
      quietestBuildingInRange(27, 36),
      ["Please, not another", "hour in traffic."],
    ],
  ] as const
).map(([buildingIndex, lines]) => {
  const building = skylineBuildings[buildingIndex];
  const centerX = building.x + building.width / 2;
  const tailApexY = SKYLINE_HEIGHT - building.height;
  const bottom =
    SKYLINE_HEIGHT - tallestNearbyHeight(centerX) - SKYLINE_BUBBLE_HEADROOM;
  return {
    centerX,
    top: bottom - SKYLINE_BUBBLE_HEIGHT,
    bottom,
    tailApexY,
    lines,
  };
});
---

<Layout
  title="Braess's paradox — will a shortcut make traffic faster?"
  description="An interactive explainer: sometimes adding a road makes everyone's commute slower, because individually rational choices can add up to a worse outcome for the group."
>
  <div class="page">
    <header class="site-header">
      <button type="button" id="replay" class="replay-button">
        Start again
      </button>
      <nav id="scene-nav" aria-label="Explainer sections" hidden>
        <a href="#experiment">The experiment</a>
        <a href="#takeaway">The takeaway</a>
      </nav>
    </header>

    <main>
      <section id="opening-scene">
        <!--
          Decorative only: faint drifting dots to suggest commuter flow
          without showing any route mechanics — the real network diagram
          belongs to Act 2. aria-hidden since it carries no information.
        -->
        <div class="ambient-flow" aria-hidden="true">
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
        </div>
        <div class="opening-content">
          <h1 id="opening-question" class="heading-with-icon">
            <svg
              class="heading-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M9 3 4 21" />
              <path d="M15 3l5 18" />
              <path d="M12 7v2.5M12 12.5v2.5M12 18v1.5" />
            </svg>
            <span>Does building more roads always make traffic better?</span>
          </h1>
          <p class="opening-hook">
            Thousands of commuters cross this city every day, each choosing
            their own way home — and city hall has just approved a brand-new
            road to ease the crush.
          </p>
          <div
            role="group"
            aria-labelledby="opening-question"
            class="prediction-options"
          >
            <button type="button">Yes, I think so</button>
            <button type="button">I'm not sure</button>
            <button type="button">Not necessarily</button>
          </div>
        </div>
        <!--
          Decorative only: a faint city skyline grounding the scene at night.
          Sits after (below) the opening content in document order so it can
          never overlap the headline, hook, or buttons. aria-hidden since it
          carries no information.
        -->
        <div class="skyline" aria-hidden="true">
          <svg
            class="skyline-svg"
            viewBox={`0 0 ${SKYLINE_WIDTH} ${SKYLINE_HEIGHT}`}
            preserveAspectRatio="xMidYMax slice"
            role="presentation"
            focusable="false"
          >
            {
              skylineBuildings.map((building) => (
                <g transform={`translate(${building.x}, ${SKYLINE_HEIGHT - building.height})`}>
                  <rect
                    width={building.width}
                    height={building.height}
                    class="skyline-building"
                  />
                  {building.windows.map((window) => (
                    <rect
                      x={window.x}
                      y={window.y}
                      width={SKYLINE_WINDOW_WIDTH}
                      height={SKYLINE_WINDOW_HEIGHT}
                      class={
                        window.lit
                          ? "skyline-window skyline-window-lit"
                          : "skyline-window"
                      }
                    />
                  ))}
                </g>
              ))
            }
            {
              skylineBubbles.map((bubble) => (
                <g class="skyline-bubble" aria-hidden="true">
                  <rect
                    x={bubble.centerX - SKYLINE_BUBBLE_WIDTH / 2}
                    y={bubble.top}
                    width={SKYLINE_BUBBLE_WIDTH}
                    height={SKYLINE_BUBBLE_HEIGHT}
                    rx={SKYLINE_BUBBLE_RADIUS}
                    class="skyline-bubble-bg"
                  />
                  <polygon
                    points={`${bubble.centerX - 8},${bubble.bottom} ${bubble.centerX + 8},${bubble.bottom} ${bubble.centerX},${bubble.tailApexY}`}
                    class="skyline-bubble-bg"
                  />
                  <text
                    x={bubble.centerX}
                    text-anchor="middle"
                    class="skyline-bubble-text"
                  >
                    <tspan x={bubble.centerX} y={bubble.top + 19}>
                      {bubble.lines[0]}
                    </tspan>
                    <tspan x={bubble.centerX} y={bubble.top + 35}>
                      {bubble.lines[1]}
                    </tspan>
                  </text>
                </g>
              ))
            }
          </svg>
        </div>
      </section>

      <section id="experiment" aria-labelledby="experiment-heading" hidden>
        <h2 id="experiment-heading" class="heading-with-icon">
          <svg
            class="heading-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M6 12 18 5" />
            <path d="M6 12 18 19" />
            <circle cx="4.5" cy="12" r="2" fill="currentColor" stroke="none" />
            <circle cx="19.5" cy="5" r="2" fill="currentColor" stroke="none" />
            <circle cx="19.5" cy="19" r="2" fill="currentColor" stroke="none" />
          </svg>
          <span>The network, right now</span>
        </h2>
        <p id="experiment-intro" class="experiment-intro" role="status"></p>

        <div class="experiment-grid">
          <!--
            Decorative: the plain-language line and readout beside it are the
            complete accessible equivalent of this diagram, so the SVG is
            hidden from assistive tech rather than also labelled, to avoid
            announcing everything twice.
          -->
          <svg
            id="network-diagram"
            class="network-diagram"
            viewBox="0 0 400 220"
            role="presentation"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="30" cy="110" r="10" class="node" />
            <circle cx="370" cy="110" r="10" class="node" />
            <circle cx="200" cy="45" r="8" class="node" />
            <circle cx="200" cy="175" r="8" class="node" />
            <text x="12" y="140" class="node-label">Start</text>
            <text x="354" y="140" class="node-label">End</text>
            <text x="188" y="30" class="node-label">A</text>
            <text x="188" y="198" class="node-label">B</text>

            <path d="M 30 110 L 200 45" class="route route-a" />
            <rect x="35" y="10" width="70" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="label-start-a"
              x="70"
              y="22"
              text-anchor="middle"
              class="route-label route-a-label"
              ><tspan class="edge-chip-main" x="70">{initialEdgeMinutes} min</tspan><tspan
                class="edge-chip-sub"
                x="70"
                dy="13">{routeDrivers} cars</tspan></text>

            <path d="M 200 45 L 370 110" class="route route-a leg-idle" />
            <rect x="235" y="10" width="70" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="label-a-end"
              x="270"
              y="22"
              text-anchor="middle"
              class="route-label route-a-label leg-idle"
              ><tspan class="edge-chip-main" x="270">45 min</tspan><tspan
                class="edge-chip-sub"
                x="270"
                dy="13">{routeDrivers} cars</tspan></text>

            <path d="M 30 110 L 200 175" class="route route-b leg-idle" />
            <rect x="35" y="180" width="70" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="label-start-b"
              x="70"
              y="192"
              text-anchor="middle"
              class="route-label route-b-label leg-idle"
              ><tspan class="edge-chip-main" x="70">45 min</tspan><tspan
                class="edge-chip-sub"
                x="70"
                dy="13">{routeDrivers} cars</tspan></text>

            <path d="M 200 175 L 370 110" class="route route-b" />
            <rect x="235" y="180" width="70" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="label-b-end"
              x="270"
              y="192"
              text-anchor="middle"
              class="route-label route-b-label"
              ><tspan class="edge-chip-main" x="270">{initialEdgeMinutes} min</tspan><tspan
                class="edge-chip-sub"
                x="270"
                dy="13">{routeDrivers} cars</tspan></text>

            <path
              id="shortcut-path"
              d="M 200 45 L 200 175"
              class="route route-shortcut"
            />
            <rect x="217" y="94" width="86" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="shortcut-label"
              x="260"
              y="106"
              text-anchor="middle"
              class="route-label route-shortcut-label"
              ><tspan class="edge-chip-main" x="260">Shortcut</tspan><tspan
                class="edge-chip-sub"
                x="260"
                dy="13">Not built</tspan></text>

            <!--
              Vehicles. Each dot is a batch of drivers, drawn as a round dash
              on top of the leg it travels. Which legs carry dots, and how
              closely spaced they are, is the whole signal — the drift is
              decoration, so the picture still reads correctly when it's
              switched off under prefers-reduced-motion (see global.css).
              `flow-through` legs carry traffic in both states, `flow-split`
              only before the shortcut, `flow-shortcut` only after.
            -->
            <path d="M 30 110 L 200 45" class="flow flow-through" />
            <path d="M 200 45 L 370 110" class="flow flow-split" />
            <path d="M 30 110 L 200 175" class="flow flow-split" />
            <path d="M 200 175 L 370 110" class="flow flow-through" />
            <path d="M 200 45 L 200 175" class="flow flow-shortcut" />

            <!--
              Only visible once the shortcut is built (toggled by the same
              .is-shortcut-built class the rest of the diagram already
              responds to — no script changes needed). Decorative: it
              dramatizes the individually-rational choice that produces the
              80-minute result, it doesn't add any information the numbers
              beside the diagram don't already state.
            -->
            <g id="car-callout" class="car-callout" aria-hidden="true">
              <rect
                x="110"
                y="2"
                width="120"
                height="32"
                rx="8"
                class="car-bubble-bg"
              />
              <polygon points="163,34 177,34 170,44" class="car-bubble-bg" />
              <text text-anchor="middle" class="car-bubble-text">
                <tspan x="170" y="15">I'll take the</tspan>
                <tspan x="170" y="27">fastest road!</tspan>
              </text>
              <g class="car-body">
                <rect
                  x="151"
                  y="50"
                  width="38"
                  height="13"
                  rx="4"
                  class="car-shape"
                />
                <rect
                  x="158"
                  y="44"
                  width="20"
                  height="9"
                  rx="3"
                  class="car-window"
                />
                <circle cx="159" cy="64" r="4" class="car-wheel" />
                <circle cx="181" cy="64" r="4" class="car-wheel" />
              </g>
            </g>
          </svg>

          <div class="experiment-readout">
            <!--
              The plain-language text equivalent of the diagram: the diagram
              itself is decorative and aria-hidden, so this line is what
              carries the traffic split for anyone not reading the picture —
              kept to one sentence so the panel stays a short summary, not a
              second copy of the per-edge numbers already on the diagram.
            -->
            <p class="driver-count" id="driver-count-note">
              {routeDrivers} drivers take each of the two original routes.
            </p>

            <p class="travel-time" role="status" id="travel-time-output">
              Current trip <strong>{equilibriumMinutes}</strong> minutes
            </p>

            <p id="equation-readout" class="equation-readout">
              {initialEquation}
            </p>

            <p
              id="unilateral-alternative"
              class="unilateral-alternative"
              hidden
            ></p>

            <button
              type="button"
              id="build-shortcut"
              class="build-button"
              aria-pressed="false"
            >
              Build the shortcut
            </button>

            <p id="shortcut-status" class="shortcut-status" hidden>
              <span aria-hidden="true">✓</span> Shortcut built
            </p>

            <button
              type="button"
              id="reveal-trigger"
              class="build-button"
              hidden
            >
              Did your prediction hold up?
            </button>
          </div>
        </div>
      </section>

      <section id="reveal" aria-labelledby="reveal-heading" hidden>
        <h2 id="reveal-heading" class="heading-with-icon">
          <svg
            class="heading-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="7" y="3" width="10" height="18" rx="4" />
            <circle cx="12" cy="7.5" r="1.8" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none" />
            <circle cx="12" cy="16.5" r="1.8" fill="currentColor" stroke="none" />
          </svg>
          <span>Did your prediction hold up?</span>
        </h2>
        <p id="prediction-comparison"></p>
      </section>

      <section id="takeaway" aria-labelledby="takeaway-heading" hidden>
        <h2 id="takeaway-heading" class="heading-with-icon">
          <svg
            class="heading-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 21V4" />
            <path d="M5 5h13l-3.5 4 3.5 4H5" />
          </svg>
          <span>The takeaway</span>
        </h2>
        <p>
          Every driver in this network acted rationally, picking whatever
          route was fastest for them individually. Braess's paradox is that
          those individually rational choices didn't add up to the best
          outcome for the group here — giving everyone a free shortcut made
          the whole system slower, even though no one made a mistake.
        </p>
        <p>
          That isn't a rule about roads in general.
          <strong
            >Adding a road — the shortcut you just built — does not always improve
            traffic</strong
          >, and this network is a case where it didn't. It's a property of
          this particular network: the shortcut removed the incentive to
          spread out, and the resulting equilibrium left everyone paying
          more than sticking with the original two routes.
        </p>
      </section>
    </main>
  </div>

  <script>
    import { initBraessExplainer } from "../scripts/braess-interaction";

    initBraessExplainer(document);
  </script>
</Layout>
