---
import Layout from "../layouts/Layout.astro";
import { calculateNetworkState } from "../scripts/braess-model";

// Tier B slice: all displayed numbers come from the real model, computed at
// build time — never hard-coded — and formatted with an explicit locale so
// the output doesn't depend on the machine building the site.
const driverCount = new Intl.NumberFormat("en-AU");
const TOTAL_DRIVERS = 4000;
const initial = calculateNetworkState({
  shortcutBuilt: false,
  totalDrivers: TOTAL_DRIVERS,
});
const routeDrivers = driverCount.format(initial.allocation.viaNode1Only);
const equilibriumMinutes = initial.equilibriumTravelTimeMinutes;
const initialEdgeMinutes = initial.allocation.viaNode1Only / 100;
const initialEquation = `${initialEdgeMinutes} + 45 = ${equilibriumMinutes} min`;
---

<Layout
  title="Braess's paradox — will a shortcut make traffic faster?"
  description="An interactive explainer: sometimes adding a road makes everyone's commute slower, because individually rational choices can add up to a worse outcome for the group."
>
  <div class="page">
    <header class="site-header">
      <button type="button" id="replay" class="replay-button">
        Start again
      </button>
      <nav id="scene-nav" aria-label="Explainer sections" hidden>
        <a href="#experiment">The experiment</a>
        <a href="#takeaway">The takeaway</a>
      </nav>
    </header>

    <main>
      <section id="opening-scene">
        <!--
          Decorative only: faint drifting dots to suggest commuter flow
          without showing any route mechanics — the real network diagram
          belongs to Act 2. aria-hidden since it carries no information.
        -->
        <div class="ambient-flow" aria-hidden="true">
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
          <span class="ambient-dot"></span>
        </div>
        <div class="opening-content">
          <h1 id="opening-question">
            Does building more roads always make traffic better?
          </h1>
          <p class="opening-hook">
            Thousands of commuters cross this city every day, each choosing
            their own way home — and city hall has just approved a brand-new
            road to ease the crush.
          </p>
          <div
            role="group"
            aria-labelledby="opening-question"
            class="prediction-options"
          >
            <button type="button">Yes, I think so</button>
            <button type="button">I'm not sure</button>
            <button type="button">Not necessarily</button>
          </div>
        </div>
      </section>

      <section id="experiment" aria-labelledby="experiment-heading" hidden>
        <h2 id="experiment-heading">The network, right now</h2>
        <p id="experiment-intro" class="experiment-intro" role="status"></p>

        <div class="experiment-grid">
          <!--
            Decorative: the plain-language line and readout beside it are the
            complete accessible equivalent of this diagram, so the SVG is
            hidden from assistive tech rather than also labelled, to avoid
            announcing everything twice.
          -->
          <svg
            id="network-diagram"
            class="network-diagram"
            viewBox="0 0 400 220"
            role="presentation"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="30" cy="110" r="10" class="node" />
            <circle cx="370" cy="110" r="10" class="node" />
            <circle cx="200" cy="45" r="8" class="node" />
            <circle cx="200" cy="175" r="8" class="node" />
            <text x="12" y="140" class="node-label">Start</text>
            <text x="354" y="140" class="node-label">End</text>
            <text x="188" y="30" class="node-label">A</text>
            <text x="188" y="198" class="node-label">B</text>

            <path d="M 30 110 L 200 45" class="route route-a" />
            <rect x="35" y="10" width="70" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="label-start-a"
              x="70"
              y="22"
              text-anchor="middle"
              class="route-label route-a-label"
              ><tspan class="edge-chip-main" x="70">{initialEdgeMinutes} min</tspan><tspan
                class="edge-chip-sub"
                x="70"
                dy="13">{routeDrivers} cars</tspan></text>

            <path d="M 200 45 L 370 110" class="route route-a leg-idle" />
            <rect x="235" y="10" width="70" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="label-a-end"
              x="270"
              y="22"
              text-anchor="middle"
              class="route-label route-a-label leg-idle"
              ><tspan class="edge-chip-main" x="270">45 min</tspan><tspan
                class="edge-chip-sub"
                x="270"
                dy="13">{routeDrivers} cars</tspan></text>

            <path d="M 30 110 L 200 175" class="route route-b leg-idle" />
            <rect x="35" y="180" width="70" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="label-start-b"
              x="70"
              y="192"
              text-anchor="middle"
              class="route-label route-b-label leg-idle"
              ><tspan class="edge-chip-main" x="70">45 min</tspan><tspan
                class="edge-chip-sub"
                x="70"
                dy="13">{routeDrivers} cars</tspan></text>

            <path d="M 200 175 L 370 110" class="route route-b" />
            <rect x="235" y="180" width="70" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="label-b-end"
              x="270"
              y="192"
              text-anchor="middle"
              class="route-label route-b-label"
              ><tspan class="edge-chip-main" x="270">{initialEdgeMinutes} min</tspan><tspan
                class="edge-chip-sub"
                x="270"
                dy="13">{routeDrivers} cars</tspan></text>

            <path
              id="shortcut-path"
              d="M 200 45 L 200 175"
              class="route route-shortcut"
            />
            <rect x="217" y="94" width="86" height="32" rx="6" class="edge-chip-bg" />
            <text
              id="shortcut-label"
              x="260"
              y="106"
              text-anchor="middle"
              class="route-label route-shortcut-label"
              ><tspan class="edge-chip-main" x="260">Shortcut</tspan><tspan
                class="edge-chip-sub"
                x="260"
                dy="13">Not built</tspan></text>

            <!--
              Vehicles. Each dot is a batch of drivers, drawn as a round dash
              on top of the leg it travels. Which legs carry dots, and how
              closely spaced they are, is the whole signal — the drift is
              decoration, so the picture still reads correctly when it's
              switched off under prefers-reduced-motion (see global.css).
              `flow-through` legs carry traffic in both states, `flow-split`
              only before the shortcut, `flow-shortcut` only after.
            -->
            <path d="M 30 110 L 200 45" class="flow flow-through" />
            <path d="M 200 45 L 370 110" class="flow flow-split" />
            <path d="M 30 110 L 200 175" class="flow flow-split" />
            <path d="M 200 175 L 370 110" class="flow flow-through" />
            <path d="M 200 45 L 200 175" class="flow flow-shortcut" />
          </svg>

          <div class="experiment-readout">
            <!--
              The plain-language text equivalent of the diagram: the diagram
              itself is decorative and aria-hidden, so this line is what
              carries the traffic split for anyone not reading the picture —
              kept to one sentence so the panel stays a short summary, not a
              second copy of the per-edge numbers already on the diagram.
            -->
            <p class="driver-count" id="driver-count-note">
              {routeDrivers} drivers take each of the two original routes.
            </p>

            <p class="travel-time" role="status" id="travel-time-output">
              Current trip <strong>{equilibriumMinutes}</strong> minutes
            </p>

            <p id="equation-readout" class="equation-readout">
              {initialEquation}
            </p>

            <p
              id="unilateral-alternative"
              class="unilateral-alternative"
              hidden
            ></p>

            <button
              type="button"
              id="build-shortcut"
              class="build-button"
              aria-pressed="false"
            >
              Build the shortcut
            </button>

            <p id="shortcut-status" class="shortcut-status" hidden>
              <span aria-hidden="true">✓</span> Shortcut built
            </p>

            <button
              type="button"
              id="reveal-trigger"
              class="build-button"
              hidden
            >
              Did your prediction hold up?
            </button>
          </div>
        </div>
      </section>

      <section id="reveal" aria-labelledby="reveal-heading" hidden>
        <h2 id="reveal-heading">Did your prediction hold up?</h2>
        <p id="prediction-comparison"></p>
      </section>

      <section id="takeaway" aria-labelledby="takeaway-heading" hidden>
        <h2 id="takeaway-heading">The takeaway</h2>
        <p>
          Every driver in this network acted rationally, picking whatever
          route was fastest for them individually. Braess's paradox is that
          those individually rational choices didn't add up to the best
          outcome for the group here — giving everyone a free shortcut made
          the whole system slower, even though no one made a mistake.
        </p>
        <p>
          That isn't a rule about roads in general.
          <strong
            >Adding a road — the shortcut you just built — does not always improve
            traffic</strong
          >, and this network is a case where it didn't. It's a property of
          this particular network: the shortcut removed the incentive to
          spread out, and the resulting equilibrium left everyone paying
          more than sticking with the original two routes.
        </p>
      </section>
    </main>
  </div>

  <script>
    import { initBraessExplainer } from "../scripts/braess-interaction";

    initBraessExplainer(document);
  </script>
</Layout>
